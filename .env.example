# OPTIONAL. Copy to .env to change settings; the backend works without any of them.
# Priority: real environment variables, then this file, then built-in defaults.
# Lines starting with # are ignored. Delete a line to go back to its default.

# Where the SQLite database file lives
# ASTRO_DB_PATH=data/runtime/astro.db

# Which demo astronaut the API serves
# ASTRO_ID=astro-demo-1

# CSV used by the seed script (put Sofia's file here)
# ASTRO_SAMPLE_CSV=data/sample/readings.csv

# Shown on /api/status
# OFFLINE_MODE=true

# Local model server (Docker on Windows/macOS: http://host.docker.internal:11434)
# OLLAMA_URL=http://127.0.0.1:11434

# Seconds to wait for the model before falling back to retrieval-only
# ASK_TIMEOUT_SECONDS=20

# Where Cesar's meta.json lives
# RAG_INDEX_DIR=rag/index

# Frontend addresses allowed to call the API (comma separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
