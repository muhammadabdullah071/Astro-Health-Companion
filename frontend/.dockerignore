# Build context is ./frontend, so paths are relative to this folder.

# Installed and generated by the image build itself (keeps the context small, avoids host/OS mismatch)
node_modules
.next
out
next-env.d.ts
*.tsbuildinfo

# Local settings and secrets
.env
.env.*
!.env.example

# Logs and tooling
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.vscode
.idea
coverage

# Not needed to build
.git
.gitignore
Dockerfile
.dockerignore
README.md
OWNERS.md
