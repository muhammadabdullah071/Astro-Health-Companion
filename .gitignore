# ROOT .gitignore: only things that apply to the whole repository.
# Language specific rules live in backend/.gitignore and frontend/.gitignore.

# Secrets and local settings (commit .env.example only)
.env
.env.local

# Generated runtime state (keep the folder with .gitkeep)
data/runtime/*
!data/runtime/.gitkeep

# RAG artefacts built on each machine (keep the folder with .gitkeep)
rag/index/*
!rag/index/.gitkeep

# Large files: share through the team drive and list them in the README
*.pdf
*.gguf
*.bin
models/

# Logs and temporary files
*.log
tmp/
*.tmp

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
